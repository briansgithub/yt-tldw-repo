{
  "manifest_version": 3,
  "name": "YT-TLDW",
  "version": "0.2.1",
  "description": "Play only essential YouTube moments (Ask/Gemini + most-replayed heatmap for Popular) and always skip sponsors (SponsorBlock API).",
  "homepage_url": "https://github.com/ajayyy/SponsorBlock",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://sponsor.ajay.app/*"
  ],
  "optional_host_permissions": [
    "https://*.ts.net/*"
  ],
  "background": {
    "scripts": [
      "lib/settings.js",
      "lib/queue-model.js",
      "lib/queue-sync.js",
      "queue-background.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "YT-TLDW settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "lib/queue-model.js",
        "lib/queue-view.js",
        "queue-content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "lib/settings.js",
        "lib/previewBar.js",
        "content.js"
      ],
      "css": [
        "content.css",
        "queue.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "@yt-tldw-private",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ],
        "optional": [
          "websiteContent",
          "authenticationInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
