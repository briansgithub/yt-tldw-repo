{
  "manifest_version": 3,
  "name": "YT-TLDW",
  "version": "0.2.0",
  "description": "Play only essential YouTube moments (Ask/Gemini + most-replayed heatmap for Popular) and always skip sponsors (SponsorBlock API).",
  "homepage_url": "https://github.com/ajayyy/SponsorBlock",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://sponsor.ajay.app/*",
    "http://127.0.0.1:47321/*"
  ],
  "optional_host_permissions": [
    "https://*.ts.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YT-TLDW settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "lib/queue-model.js",
        "lib/queue-view.js",
        "queue-content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "lib/settings.js",
        "lib/previewBar.js",
        "content.js"
      ],
      "css": [
        "content.css",
        "queue.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
